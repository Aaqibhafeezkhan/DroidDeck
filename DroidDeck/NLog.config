<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <!-- Divide em 5 MB e guarda só os 2 arquivos anteriores (no máximo ~15 MB no disco). -->
    <target xsi:type="File" name="logfile" fileName="${specialfolder:folder=LocalApplicationData}/DroidDeck.log"
            layout="${longdate}|${level}|${logger}|${message}|${exception:format=tostring}"
            archiveAboveSize="5242880" maxArchiveFiles="2" />
  </targets>
  <rules>
    <!-- O ASP.NET e o HttpClient registram cada requisição em Info; o app consulta mídia e mixer
         o tempo todo, então só avisos e erros deles. A linha de "escutando em" continua. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="logfile" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="logfile" />
  </rules>
</nlog>
